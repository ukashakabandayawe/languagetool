<rules lang="lg"
    xsi:noNamespaceSchemaLocation="../../../../../../../../../languagetool-core/src/main/resources/org/languagetool/rules/rules.xsd"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- ================================================================= -->
    <!-- EMPANDIIKA Y'OLUGANDA (LUGANDA ORTHOGRAPHY RULES)                 -->
    <!-- ================================================================= -->
    <category id="EMPANDIIKA_Y_OLUGANDA" name="Empandiika y'Oluganda (Orthography)">
        <!-- Gibberish -->
        <rulegroup id="GIBBERISH" name="Gibberish">
            <rule>
                <pattern>
                    <token regexp="yes">
                        [aeiouAEIOU]{5,}|[bcdfghjklmnpqrstvwxyzBCDFGHJKLMNPQRSTVWXYZ]{5,}</token>
                </pattern>
                <message>Ekigambo kirabika kifu.</message>
                <short>Ekigambo ekifu</short>
                <example correction="">Oyo muntu <marker>eftewgf</marker> mukulu.</example>
                <example>Oyo muntu mukulu.</example>
            </rule>
        </rulegroup>

        <!-- L vs R Usage Rules in Luganda -->
        <rulegroup id="L_VS_R_RULES" name="Enkozesa y'ennyukuta L ne R">
            <!-- R at word start is generally invalid in Luganda -->
            <rule>
                <pattern>
                    <token regexp="yes">^[Rr]adiyo$</token>
                </pattern>
                <message>Mu Luganda ennyukuta 'r' tetandika bigambo. Mukifo kya 'r' tukozesa 'l'.
                    Gezaako: <suggestion><match no="1" regexp_match="^[Rr]" regexp_replace="l" /></suggestion>
                    .</message>
                <short>Empandiika ya L mu kifo kya R</short>
                <example correction="ladiyo">Ggwe waguze <marker>radiyo</marker> empya.</example>
                <example>Ggwe waguze ladiyo empya.</example>
            </rule>
            <rule>
                <pattern>
                    <token regexp="yes">^[Kk]uraba$</token>
                </pattern>
                <message>Mu Luganda ennyukuta 'r' tekozesebwa oluvannyuma lwa 'u': gezaako <suggestion><match
                            no="1" regexp_match="[Rr]" regexp_replace="l" /></suggestion>.</message>
                <short>Ennyukuta L mu kifo kya R</short>
                <example correction="kulaba">Njagala <marker>kuraba</marker> omupiira.</example>
                <example>Njagala kulaba mupiira.</example>
            </rule>
            <rule>
                <pattern>
                    <token regexp="yes">^[Oo]muriro$</token>
                </pattern>
                <message>Mu Luganda ennyukuta 'l' ekozesebwa oluvannyuma lwa 'u': Gezaako <suggestion><match
                            no="1" regexp_match="^[Oo]mu[rR]" regexp_replace="omul" /></suggestion>.</message>
                <short>Ennyukuta L mu kifo kya R</short>
                <example correction="omuliro">Baakuma <marker>omuriro</marker> ne bafumba.</example>
                <example>Baakuma omuliro ne bafumba.</example>
            </rule>
            <rule>
                <pattern>
                    <token regexp="yes">^[Bb]urungi$</token>
                </pattern>
                <message>Oluvannyuma lwa 'u' tukozesa 'l' sso ssi 'r': Gezaako <suggestion><match
                            no="1" regexp_match="[Rr]" regexp_replace="l" /></suggestion>.</message>
                <short>Ennyukuta L mu kifo kya R</short>
                <example correction="bulungi">Okoze <marker>burungi</marker> nnyo.</example>
                <example>Okoze bulungi nnyo.</example>
            </rule>
            <rule>
                <pattern>
                    <token regexp="yes">^[Kk]are$</token>
                </pattern>
                <message>Oluvannyuma lwa 'a' tukozesa 'l' so si 'r': Gezaako <suggestion><match
                            no="1" regexp_match="[Rr]" regexp_replace="l" /></suggestion>.</message>
                <short>Ennyukuta L mu kifo kya R</short>
                <example correction="kale">Awo <marker>kare</marker> tunaagenda enkya.</example>
                <example>Awo kale tunaagenda enkya.</example>
            </rule>
            <rule>
                <pattern>
                    <token regexp="yes">^[Ee]linya$</token>
                </pattern>
                <message>Oluvannyuma lwa 'e' oba 'i' tukozesa 'r' so si 'l': Gezaako <suggestion><match
                            no="1" regexp_match="[Ll]" regexp_replace="r" /></suggestion>.</message>
                <short>Ennyukuta R mu kifo kya L</short>
                <example correction="Erinnya"><marker>Elinya</marker> lyo ggwe ani?</example>
                <example>Erinnya lyo ggwe ani?</example>
            </rule>
        </rulegroup>

        <!-- Consonant Gemination (Ennyukuta Enzibire) -->
        <rulegroup id="CONSONANT_GEMINATION" name="Ennyukuta Enzibire (Gemination)">
            <rule>
                <pattern>
                    <token regexp="yes">^[Ss]ebo$</token>
                </pattern>
                <message>Mu mpandiika y'Oluganda entongole ekigambo kino kyetaagisa ennyukuta s
                    ebbiri: Gezaako <suggestion><match no="1" regexp_match="^[Ss]"
                            regexp_replace="ss" /></suggestion>.</message>
                <short>Ennyukuta 'ss' enzibire</short>
                <example correction="ssebo">Osiibye otyanno <marker>sebo</marker>?</example>
                <example>Osiibye otyanno ssebo?</example>
            </rule>
            <rule>
                <pattern>
                    <token regexp="yes">^[Nn]yabo$</token>
                </pattern>
                <message>Mu mpandiika y'Oluganda entongole ekigambo kino kyetaagisa ennyukuta nn
                    ebbiri: Gezaako <suggestion><match no="1" regexp_match="^[Nn]"
                            regexp_replace="nn" /></suggestion>.</message>
                <short>Ennyukuta 'nn' enzibire</short>
                <example correction="nnyabo">Webale nnyo <marker>nyabo</marker>.</example>
                <example>Webale nnyo nnyabo.</example>
            </rule>
        </rulegroup>

        <!-- Common Greetings and G/J Spellings -->
        <rulegroup id="GREETINGS_SPELLING" name="Empandiika y'Ebiramuso n'Ebigambo Ebirala">
            <rule>
                <pattern>
                    <token regexp="yes">^[Jj]ebaleko$</token>
                </pattern>
                <message>Ekigambo kino kiwandiikibwa na 'gy' mu kifo kya 'j': Gezaako <suggestion><match
                            no="1" regexp_match="^[Jj]" regexp_replace="gy" /></suggestion>.</message>
                <short>Empandiika ya Gyebaleko</short>
                <example correction="gyebaleko">Bannange <marker>mujebaleko</marker>.</example>
                <example>Bannange mugyebaleko.</example>
            </rule>
            <rule>
                <pattern>
                    <token regexp="yes">^[Jj]endi$</token>
                </pattern>
                <message>Ekigambo kino kiwandiikibwa na 'gy' mu kifo kya 'j': Gezaako <suggestion><match
                            no="1" regexp_match="^[Jj]" regexp_replace="gy" /></suggestion>.</message>
                <short>Empandiika ya Gyendi</short>
                <example correction="gyendi">Nze <marker>jendi</marker>.</example>
                <example>Nze gyendi.</example>
            </rule>
            <rule>
                <pattern>
                    <token regexp="yes">^[Mm]wevale$</token>
                </pattern>
                <message>Ekigambo kino kiwandiikibwa na 'b' mu kifo kya 'v': Gezaako <suggestion><match
                            no="1" regexp_match="v" regexp_replace="b" /></suggestion>.</message>
                <short>Empandiika ya Mwebale</short>
                <example correction="mwebale">Bannange <marker>mwevale</marker> okujja.</example>
                <example>Bannange mwebale okujja.</example>
            </rule>
        </rulegroup>

    </category>

    <!-- ================================================================= -->
    <!--                ELISION & CONTRACTION RULES                        -->
    <!-- ================================================================= -->
    <category id="ELISION" name="Elisions and Contractions">

        <!-- Ne before Vowels should contract to n' -->
        <rulegroup id="NE_BEFORE_VOWEL"
            name="Akatonnyeze ku 'ne' oluvannyuma lw'Enjatuza (ne -> n')">
            <rule>
                <pattern>
                    <token regexp="yes">^[Nn]e$</token>
                    <token regexp="yes">^[aeiouAEIOU].*</token>
                </pattern>
                <message>Ekigambo "ne" kisalwako ne kifuuka "n" nga kigattiddwa ku kigambo
                    ekitandika n'enjatuza: Gezaako <suggestion>n'\2</suggestion>.</message>
                <short>Kozesa n' mu kifo kya ne mu maaso g'enjatuza</short>
                <example correction="n'\2">Twagala caayi <marker>ne </marker>amata.</example>
                <example>Twayagala caayi n'amata.</example>
            </rule>
        </rulegroup>

        <!-- Missing apostrophe in velar nasal digraph ng' -->
        <rulegroup id="NG_DIGRAPH_APOSTROPHE" name="Akatonnyeze mu Nnyukuta ng'">
            <rule>
                <pattern>
                    <token regexp="yes">^[Ee]ngaano$</token>
                </pattern>
                <message>Ekigambo kino kyetaagisa akatonnyeze (apostrophe) mu nnyukuta ey'empewo
                    "ng'": Gezaako <suggestion>eng'aano</suggestion>.</message>
                <short>Akatonnyeze mu ng'aano</short>
                <example correction="eng'aano">Twaguze <marker>engaano</marker> enkya.</example>
                <example>Twaguze eng'aano enkya.</example>
            </rule>
            <rule>
                <pattern>
                    <token regexp="yes">^[Ee]ngaali$</token>
                </pattern>
                <message>Ekigambo kino kyetaagisa akatonnyeze ku 'ng\'': Gezaako <suggestion>
                    eng'aali</suggestion>.</message>
                <short>Akatonnyeze mu eng'aali</short>
                <example correction="eng'aali">Twalabye <marker>engaali</marker> ku nnyanja.</example>
                <example>Twalabye eng'aali ku nnyanja.</example>
            </rule>
            <rule>
                <pattern>
                    <token regexp="yes">^[Ee]nguumi$</token>
                </pattern>
                <message>Ekigambo kino kyetaagisa akatonnyeze ku 'ng\'': Gezaako <suggestion>
                    eng'uumi</suggestion>.</message>
                <short>Akatonnyeze mu eng'uumi</short>
                <example correction="eng'uumi">Yamusaze <marker>enguumi</marker> emu.</example>
                <example>Yamusaze eng'uumi emu.</example>
            </rule>
            <rule>
                <pattern>
                    <token regexp="yes">^[Ee]ngamiya$</token>
                </pattern>
                <message>Ekigambo kino kyetaagisa akatonnyeze ku 'ng\'': Gezaako <suggestion>
                    eng'amiya</suggestion>.</message>
                <short>Akatonnyeze mu eng'amiya</short>
                <example correction="eng'amiya">Eyo ye <marker>engamiya</marker> ey'omu ddungu.</example>
                <example>Eyo ye eng'amiya ey'omu ddungu.</example>
            </rule>
            <rule>
                <pattern>
                    <token regexp="yes">^[Ee]bbiringanya$</token>
                </pattern>
                <message>Ekigambo kino kyetaagisa akatonnyeze ku 'ng\'': Gezaako <suggestion>
                    ebbiring'anya</suggestion>.</message>
                <short>Akatonnyeze mu ebbiring'anya</short>
                <example correction="ebbiring'anya">Twafumbye <marker>ebbiringanya</marker> ku mmere.</example>
                <example>Twafumbye ebbiring'anya ku mmere.</example>
            </rule>
            <rule>
                <pattern>
                    <token regexp="yes">^[Kk]ungaanya$</token>
                </pattern>
                <message>Ekigambo kino kyetaagisa akatonnyeze ku 'ng\'': Gezaako <suggestion>
                    kung'aanya</suggestion>.</message>
                <short>Akatonnyeze mu kung'aanya</short>
                <example correction="kung'aanya">Tulina <marker>kungaanya</marker> ssente.</example>
                <example>Tulina kung'aanya ssente.</example>
            </rule>
        </rulegroup>

        <rule id="SPACE_AFTER_APOSTROPHE" name="Space After Apostrophe Rule">
            <pattern>
                <token regexp="yes">o?(w|gw|bw|lw|tw)|a?(b|g|k)|e?(w|z|y|gy|ry|by|ky)|n</token>
                <token>'</token>
                <token regexp="yes" spacebefore="yes">[aeiouAEIOU].*</token>
            </pattern>
            <message>Wano tolekaawo kabanga. Kino ekigambo kiyina kuba: <suggestion>\1\2\3</suggestion></message>
            <example>Ez'<marker>\1\2\3</marker>abaana</example>
        </rule>
        <rule id="SPACE_BEFORE_APOSTROPHE" name="Space Before Apostrophe Rule">
            <pattern>
                <token regexp="yes">o?(w|gw|bw|lw|tw)|a?(b|g|k)|e?(w|z|y|gy|ry|by|ky)|n</token>
                <token spacebefore="yes">'</token>
                <token regexp="yes" spacebefore="no">[aeiouAEIOU].*</token>
            </pattern>
            <message>Wano tolekaawo kabanga. Kino ekigambo kiyina kuba: <suggestion>\1\2\3</suggestion></message>
            <example>Ez'<marker>\1\2\3</marker>abaana</example>
        </rule>
        <rule id="APOSTROPHE_BETWEEN_SPACES" name="Apostrophe Between Spaces Rule">
            <pattern>
                <token regexp="yes">o?(w|gw|bw|lw|tw)|a?(b|g|k)|e?(w|z|y|gy|ry|by|ky)|n</token>
                <token spacebefore="yes">'</token>
                <token regexp="yes" spacebefore="yes">[aeiouAEIOU].*</token>
            </pattern>
            <message>Wano tobuukawo mabanga. Kino ekigambo kiyina kuba: <suggestion>\1\2\3</suggestion></message>
            <example>Ez'<marker>\1\2\3</marker>abaana</example>
        </rule>

    </category>

    <!-- ================================================================= -->
    <!-- EBIGAMBO EBITERA OKUKYAMIZIBWA (COMMONLY CONFUSED WORDS)         -->
    <!-- ================================================================= -->
    <category id="EBIGAMBO_EBITERA_OKUKYAMIZIBWA"
        name="Ebigambo Ebitera Okukyamizibwa (Common Confusions)">

        <!-- Kulwokuba / Lwa kuba -->
        <rulegroup id="KU_LW_OKUBA_SPLIT" name="Empandiika ya ku lw'okuba">
            <rule>
                <pattern>
                    <token regexp="yes">^[Kk]ulwokuba$</token>
                </pattern>
                <message>Ebigambo bino byawulwamu era biteekebwako akatonnyeze: Gezaako <suggestion>ku
                    lw'okuba</suggestion> oba <suggestion>kubanga</suggestion>.</message>
                <short>Empandiika ya ku lw'okuba</short>
                <example correction="ku lw'okuba|kubanga">Tetwazze <marker>kulwokuba</marker> enkuba
                    yatonnye.</example>
                <example>Tetwazze ku lw'okuba enkuba yatonnye.</example>
            </rule>
        </rulegroup>

        <!-- Bulijjo spelling -->
        <rulegroup id="BULIJJO_SPELLING" name="Empandiika ya bulijjo">
            <rule>
                <pattern>
                    <token regexp="yes">^[Bb]uli$</token>
                    <token regexp="yes">^[Jj]jo$</token>
                </pattern>
                <message>Ekigambo kino kiwandiikibwa wamu: Gezaako <suggestion>bulijjo</suggestion>.</message>
                <short>Empandiika ya bulijjo</short>
                <example correction="bulijjo">Nze nkola ekyo <marker>buli jjo</marker>.</example>
                <example>Nze nkola ekyo bulijjo.</example>
            </rule>
            <rule>
                <pattern>
                    <token regexp="yes">^[Bb]urijjo$</token>
                </pattern>
                <message>Oluvannyuma lwa 'u' tukozesa 'l': Gezaako <suggestion>bulijjo</suggestion>.</message>
                <short>Empandiika ya bulijjo</short>
                <example correction="bulijjo">Tukola tutyo <marker>burijjo</marker>.</example>
                <example>Tukola tutyo bulijjo.</example>
            </rule>
        </rulegroup>

        <!-- Nga bwe split -->
        <rulegroup id="NGA_BWE_SPLIT" name="Nga bwe">
            <rule>
                <pattern>
                    <token regexp="yes">^[Nn]gabwe$</token>
                </pattern>
                <message>Ebigambo bino biwandiikibwa byawuddwamu: Gezaako <suggestion>nga bwe</suggestion>
                    .</message>
                <short>Empandiika ya nga bwe</short>
                <example correction="nga bwe">Kiri <marker>ngabwe</marker> twakimanyi.</example>
                <example>Kiri nga bwe twakimanyi.</example>
            </rule>
        </rulegroup>

        <!-- Kale nno split -->
        <rulegroup id="KALE_NNO_SPLIT" name="Kale nno">
            <rule>
                <pattern>
                    <token regexp="yes">^[Kk]alenno$</token>
                </pattern>
                <message>Ebigambo bino biwandiikibwa byawuddwamu: Gezaako <suggestion>kale nno</suggestion>
                    .</message>
                <short>Empandiika ya kale nno</short>
                <example correction="kale nno">Awo <marker>kalenno</marker> ka tugende.</example>
                <example>Awo kale nno ka tugende.</example>
            </rule>
        </rulegroup>

        <!-- Oli otya greeting -->
        <rulegroup id="OLI_OTYA_SPELLING" name="Oli otya">
            <rule>
                <pattern>
                    <token regexp="yes">^[Oo]li$</token>
                    <token regexp="yes">^[Oo]tyo$</token>
                </pattern>
                <message>Mu kubuuza olw'omulembe tugamba: <suggestion>oli otya</suggestion>.</message>
                <short>Empandiika ya oli otya</short>
                <example correction="oli otya">Munno <marker>oli otyo</marker>?</example>
                <example>Munno oli otya?</example>
            </rule>
        </rulegroup>

    </category>

    <!-- ================================================================= -->
    <!-- OKUDDING'ANA KW'EBIGAMBO (WORD REPETITION & REDUNDANCY)           -->
    <!-- ================================================================= -->
    <category id="OKUDDING_ANA_KW_EBIGAMBO" name="Okudding'ana kw'Ebigambo (Redundancy)">

        <!-- Ate era redundancy -->
        <rulegroup id="ATE_ERA_REDUNDANCY" name="Ate era (Redundancy)">
            <rule>
                <pattern>
                    <token regexp="yes">^[Aa]te$</token>
                    <token>era</token>
                </pattern>
                <message>Ebigambo 'ate era' biddamu amakulu ge gamu. Kozesa kimu ku bino: <suggestion>
                    ate</suggestion> oba <suggestion>era</suggestion>.</message>
                <short>Okuddang'ana kw'ebigambo 'ate era'</short>
                <example correction="ate|era">Yazze <marker>ate era</marker> n'atwaala ebintu.</example>
                <example>Yazze era n'atwaala ebintu.</example>
            </rule>
        </rulegroup>

        <!-- Repeated Connectors -->
        <rulegroup id="REPEATED_CONNECTORS" name="Okuddiŋŋana kw'ebigambo ebigatta">
            <rule>
                <pattern>
                    <token regexp="yes">^[Kk]ubanga$</token>
                    <token regexp="yes">^[Kk]ubanga$</token>
                </pattern>
                <message>Ekigambo kino kiddiddwamu. Gezaako: <suggestion>kubanga</suggestion>.</message>
                <short>Okuddiŋŋana kwa 'kubanga'</short>
                <example correction="kubanga">Tetwazze <marker>kubanga kubanga</marker> twabadde tulwade.</example>
                <example>Tetwazze kubanga twabadde tulwade.</example>
            </rule>
            <rule>
                <pattern>
                    <token regexp="yes">^[Ee]ra$</token>
                    <token regexp="yes">^[Ee]ra$</token>
                </pattern>
                <message>Ekigambo kino kiddiddwamu. Gezaako: <suggestion>era</suggestion>.</message>
                <short>Okuddiŋŋana kwa 'era'</short>
                <example correction="era">Twasanyuse <marker>era era</marker> ne tuyimba.</example>
                <example>Twasanyuse era ne tuyimba.</example>
            </rule>
            <rule>
                <pattern>
                    <token regexp="yes">^[Nn]ga$</token>
                    <token regexp="yes">^[Nn]ga$</token>
                </pattern>
                <message>Ekigambo kino kiddiddwamu. Gezaako: <suggestion>nga</suggestion>.</message>
                <short>Okuddiŋŋana kwa 'nga'</short>
                <example correction="nga">Yali akola <marker>nga nga</marker> bwe baamulagira.</example>
                <example>Yali akola nga bwe baamulagira.</example>
            </rule>
        </rulegroup>

    </category>
    <!--
    ============================================================================================================================= -->
    <!--                                                    OBUBONERO (PUNCTUATION)                                                    -->
    <!--
    ============================================================================================================================= -->
    <category id="PUNCTUATION" name="Obubonero">
        <rule id="REDUNDANT_PUNCTUATION" name="Redundant Punctuation Rule">
            <pattern>
                <token regexp="yes">[.?,;:]</token>
                <token regexp="yes">[.?,;:]</token>
            </pattern>
            <message>Okozesezza obubonero obusukkiridde.</message>
            <suggestion><match no="1" regexp_match="([.?!,;:]){2,}" regexp_replace="\1" /></suggestion>
            <example correction="?">Obeera wa<marker>??</marker></example>
            <example>Obeera wa?</example>
        </rule>
        <rule id="MISSING_QUESTION_MARK" name="Missing Question Mark Rule">
            <pattern>
                <token regexp="yes">^(ki|ddi)$</token>
                <token regexp="yes">^(?!\?$).+</token>
            </pattern>
            <message>Kirabika wano wetaagawo akabonero akabuuza. </message>
            <suggestion>\1?</suggestion>
            <example correction="?">Obeera wa<marker>ki</marker></example>
            <example>Obeera wa?</example>
        </rule>
        <rule id="MISSING_SPACE_AFTER_PERIOD_AND_QUESTION_MARK" name="Missing Space After Period and Question Mark Rule">
            <pattern>
                <token regexp="yes">[.?]{1}</token>
                <token regexp="yes" spacebefore="no" case_sensitive="no">[A-Z].*</token>
            </pattern>
            <message>Wano buukawo akabanga.</message> 
            <suggestion>\1 <match no="2" case_conversion="startupper" /></suggestion>
            <example correction="? ">Obeera wa<marker>?</marker>Era oyagala ki</example>
            <example>Obeera wa? Era oyagala ki</example>
        </rule>
        <rule id="MISSING_SPACE_AFTER_PUNCTUATION" name="Missing Space After Punctuation Rule">
            <pattern>
                <token regexp="yes">[;:]{1}</token>
                <token regexp="yes" spacebefore="no" case_sensitive="no">[A-Z].*</token>
            </pattern>
            <message>Buukawo akabanga oluvannyuma lw'akabonero</message>
            <suggestion>\1 \2</suggestion>
            <example correction="? ">Ekibuuzo<marker>:</marker>Oyagala ki?</example>
            <example>Ekibuuzo: Oyagala ki?</example>
        </rule>
        <rule id="USELESS_SPACES_AROUND_PUNCTUATION" name="Useless Spaces Around Punctuation Rule">
            <pattern>
                <token regexp="yes" case_sensitive="no">[a-z].*</token>
                <token regexp="yes" spacebefore="yes">[,;:!/]{1}</token>
                <token regexp="yes" spacebefore="yes" case_sensitive="no">[a-z].*</token>
            </pattern>
            <message>Tobuukawo mabanga oluvannyuma n'oluberyeberye lw'akabonero kano</message>
            <suggestion>\1\2 \3</suggestion>
            <example correction="?">Obeera wa<marker> ?</marker>Era oyagala ki</example>
            <example>Obeera wa? Era oyagala ki</example>
        </rule>
        <rule id="USELESS_SPACES_AROUND_QMARK_AND_PERIOD" name="Useless Spaces Around ? and . Rule">
            <pattern>
                <token regexp="yes" case_sensitive="no">[a-z].*</token>
                <token regexp="yes" spacebefore="yes">[.?]{1}</token>
                <token regexp="yes" spacebefore="yes" case_sensitive="no">[a-z].*</token>
            </pattern>
            <message>Tobuukawo mabanga oluvannyuma n'oluberyeberye lw'akabonero kano</message>
            <suggestion>\1\2 <match no="3" case_conversion="startupper" /></suggestion>
            <example correction="?">Obeera wa<marker> ?</marker>Era oyagala ki</example>
            <example>Obeera wa? Era oyagala ki</example>
        </rule>
        <rule id="SPACE_PUNCTUATION_NO_SPACE" name="Useless Space Before Punctuation, yet there is no space after it">
            <pattern>
                <token regexp="yes" case_sensitive="no">[a-z].*</token>                
                <token regexp="yes" spacebefore="yes">[:;!/]{1}</token>
                <token regexp="yes" spacebefore="no" case_sensitive="no">[a-z].*</token>
            </pattern>
            <message>Tebabuukawo kabanga ku luberyeberye lw'akabonero kano kyokka ate babuukawo oluvannyuma lw'ako</message>
            <suggestion>\1\2 \3</suggestion>
            <example correction="?">Obeera wa<marker> ?</marker>Era oyagala ki</example>
            <example>Obeera wa? Era oyagala ki</example>
        </rule>
        <rule id="SPACE_QMARK_PERIOD_NO_SPACE" name="Useless Space Before Question Mark or Period, yet there is no space after it">
            <pattern>
                <token regexp="yes" case_sensitive="no">[a-z].*</token>                
                <token regexp="yes" spacebefore="yes">[.?]{1}</token>
                <token regexp="yes" spacebefore="no" case_sensitive="no">[a-z].*</token>
            </pattern>
            <message>Tebabuukawo kabanga ku luberyeberye lw'akabonero kano kyokka ate babuukawo oluvannyuma lw'ako</message>
            <suggestion>\1\2 <match no="3" case_conversion="startupper" /></suggestion>
            <example correction="?">Obeera wa<marker> ?</marker>Era oyagala ki</example>
            <example>Obeera wa? Era oyagala ki</example>
        </rule>
        <rule id="USELESS_SPACE_BEFORE_PUNCTUATION" name="Useless Space Before Punctuation Rule">
            <pattern>
                <token regexp="yes" spacebefore="no" case_sensitive="no">[a-z].*</token>                
                <token regexp="yes" spacebefore="yes">[?!]{1}</token>
            </pattern>
            <message>Wano tobuukawo kabanga.</message>
            <suggestion>\1\2</suggestion>
            <example correction="?">Obeera wa<marker> ?</marker>Era oyagala ki</example>
            <example>Obeera wa? Era oyagala ki</example>
        </rule>
    </category>
    <!--
    ============================================================================================================================= -->
    <!--                                                 ENNUKUTA ENNENE (CAPITALIZATION)                                              -->
    <!--
    ============================================================================================================================= -->
    <category id="CAPITALIZATION" name="Ennukuta Ennene">
        <rule id="UPPERCASE_AFTER_PERIOD" name="Uppercase After Period Rule">
            <pattern>
                <token>.</token>
                <token regexp="yes" case_sensitive="yes" spacebefore="yes">[a-z].*</token>
            </pattern>
            <message>Ssentensi eyina kutandika na nnukuta nnene </message>
            <suggestion> <match no="2" case_conversion="startupper" /> </suggestion>
            <example>Erinnya lyange nze Nsubuga.<marker> nsomera</marker> Kampala</example>
            <example>Erinnya lyange nze Nsubuga. Nsomera Kampala </example>
        </rule>
        <rule id="UPPERCASE_AFTER_QUESTION_MARK" name="Uppercase After Question Mark Rule">
            <pattern>
                <token>?</token>
                <token regexp="yes" case_sensitive="yes" spacebefore="yes">[a-z].*</token>
            </pattern>
            <message>Ssentensi etaandika na nnukuta nnene </message>
            <suggestion> <match no="2" case_conversion="startupper" /> </suggestion>
            <example>Erinnya lyo gwe Nsubuga?<marker> obwedda</marker> bakuyita</example>
            <example>Erinnya lyo gwe Nsubuga? obwedda bakuyita</example>
        </rule>
    </category>
</rules>